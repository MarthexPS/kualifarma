<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventario"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewProduct"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#2563EB"
            android:text="+ Nuevo"
            app:cornerRadius="8dp" />
    </RelativeLayout>

    <!-- Buscador con ícono de cámara en Inventario -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp">

        <EditText
            android:id="@+id/etSearchInventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/ivCameraScanInv"
            android:background="@null"
            android:hint="Filtrar por nombre o lote..."
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivCameraScanInv"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Escanear"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_camera" />
    </RelativeLayout>

    <!-- Chips de Filtrado -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupInventory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos (148)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterLowStock"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bajo Stock (5)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterExpiring"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próximos a Caducar (3)" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item 1: Amoxicilina (Disponible) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProduct1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvProd1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amoxicilina 500 mg"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvProd1Name"
                        android:text="Lote: AMX-224 • Expiración: 12/26\n$120.00 MXN"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="#DCFCE7"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Disponible\n150 pzas"
                        android:textColor="#166534"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 2: Loratadina (Agotado) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProduct2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvProd2Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loratadina 10 mg"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvProd2Name"
                        android:text="Lote: LOR-012 • Expiración: 04/27\n$45.00 MXN"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="#FEE2E2"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Agotado\n0 pzas"
                        android:textColor="#991B1B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 3: Omeprazol (Bajo Stock) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProduct3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvProd3Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Omeprazol 20 mg"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvProd3Name"
                        android:text="Lote: OMP-552 • Expiración: 05/26\n$32.50 MXN"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="#FFEDD5"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Bajo Stock\n5 pzas"
                        android:textColor="#9A3412"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>